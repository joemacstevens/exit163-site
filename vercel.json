{
  "buildCommand": "",
  "outputDirectory": ".",
  "functions": {
    "api/sms.js": {
      "maxDuration": 15
    },
    "api/sms-status.js": {
      "maxDuration": 15
    },
    "api/reflect.js": {
      "maxDuration": 300
    },
    "api/followup.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/holidays",
      "destination": "/holidays.html"
    },
    {
      "source": "/weekend",
      "destination": "/weekend.html"
    },
    {
      "source": "/claim",
      "destination": "/claim.html"
    },
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/((?!api/|llms\\.txt).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/reflect",
      "schedule": "0 8 * * *"
    }
  ]
}
