{
  "buildCommand": "",
  "outputDirectory": ".",
  "functions": {
    "api/sms.js": {
      "maxDuration": 15
    },
    "api/claim.js": {
      "maxDuration": 30
    },
    "api/review.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/holidays",
      "destination": "/holidays.html"
    },
    {
      "source": "/weekend",
      "destination": "/weekend.html"
    },
    {
      "source": "/claim",
      "destination": "/claim.html"
    },
    {
      "source": "/review",
      "destination": "/review.html"
    },
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/((?!api/|llms\\.txt).*)",
      "destination": "/index.html"
    }
  ]
}
