# Copy to Vercel -> Project exit163-site -> Settings -> Environment Variables.
# Never commit real values.

# Already set
RESEND_API_KEY=                     

# Database (Supabase project "exit163", ref sswhjnkiotpsccxlirwp)
SUPABASE_URL=https://sswhjnkiotpsccxlirwp.supabase.co
SUPABASE_SERVICE_ROLE_KEY=           # Supabase -> Project Settings -> API keys -> secret / service_role

# Texting buddy
ANTHROPIC_API_KEY=                   # console.anthropic.com -> API keys
ANTHROPIC_MODEL=claude-opus-5-5      # optional; claude-haiku-5-5 is the cheap option
ANTHROPIC_EFFORT=low                 # optional
TWILIO_ACCOUNT_SID=                 
TWILIO_AUTH_TOKEN=                   # also used to verify Twilio webhooks
TWILIO_FROM_NUMBER=                  # or set TWILIO_MESSAGING_SERVICE_SID instead
TWILIO_MESSAGING_SERVICE_SID=       
TEXT_LINE_NUMBER=                    # optional: number shown on the site ("text JOIN to ..."); defaults to TWILIO_FROM_NUMBER
PUBLIC_BASE_URL=https://www.exit163.com # must match the URL Twilio calls, for signature checks

# Weekly text blast (POST /api/blast with "Authorization: Bearer <ADMIN_TOKEN>")
# and the private review page at /review, which asks for this token
ADMIN_TOKEN=                         # any long random string

# Sponsor checkout (optional until you set a price)
STRIPE_SECRET_KEY=                  
STRIPE_SPONSOR_PRICE_ID=             # a recurring monthly price
STRIPE_WEBHOOK_SECRET=               # from the webhook endpoint /api/stripe-webhook

# Where claim / sponsor notifications go
NOTIFY_EMAIL=joemac79@gmail.com     
